{
  "$defs": {
    "Task1ModelStatus": {
      "additionalProperties": false,
      "properties": {
        "late_model": {
          "enum": [
            "synthetic",
            "loaded"
          ],
          "title": "Late Model",
          "type": "string"
        },
        "service_model": {
          "enum": [
            "synthetic",
            "loaded"
          ],
          "title": "Service Model",
          "type": "string"
        }
      },
      "required": [
        "service_model",
        "late_model"
      ],
      "title": "Task1ModelStatus",
      "type": "object"
    },
    "Task1Prediction": {
      "additionalProperties": false,
      "properties": {
        "pred_late_prob": {
          "maximum": 1,
          "minimum": 0,
          "title": "Pred Late Prob",
          "type": "number"
        },
        "pred_service_min": {
          "minimum": 0,
          "title": "Pred Service Min",
          "type": "number"
        }
      },
      "required": [
        "pred_service_min",
        "pred_late_prob"
      ],
      "title": "Task1Prediction",
      "type": "object"
    }
  },
  "$id": "https://wayloom.local/integration/1.0/task1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "delivery_ref": {
      "pattern": "^DEMO_DELIVERY_[0-9]{3}$",
      "title": "Delivery Ref",
      "type": "string"
    },
    "model_status": {
      "$ref": "#/$defs/Task1ModelStatus"
    },
    "prediction": {
      "$ref": "#/$defs/Task1Prediction"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "synthetic_demo",
        "private_local"
      ],
      "title": "Source Mode",
      "type": "string"
    }
  },
  "required": [
    "source_mode",
    "delivery_ref",
    "prediction",
    "model_status"
  ],
  "title": "Task1Response",
  "type": "object"
}
