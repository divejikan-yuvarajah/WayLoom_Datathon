        districtTravel["District outbound and inter-stop travel reference"]
        serviceAllowance["Service allowance by brand plus dock_type"]
    end

    scenarioFleet["Canonical S1 scenario and available fleet only"]
    compatibility["Order x vehicle compatibility"]
    tripFormula["trip minutes = outbound + inter-stop x orders minus one + sum service allowance"]
    noReturn["No return leg is added"]

    subgraph hardRules["OFFICIAL HARD FEASIBILITY - seven rule groups"]
        ruleOne["1. Same brand and district per trip"]
        ruleTwo["2. Chilled requires reefer"]
        ruleThree["3. van_only requires van"]
        ruleFour["4. Home depot must match"]
        ruleFive["5. Whole order; no split"]
        ruleSix["6. Weight and volume capacity"]
        ruleSeven["7. At most two trips; Fresh <= 270 min; Style plus Tech <= 480 min"]
    end

    subgraph softPolicy["WAYLOOM SOFT PRIORITY - not organizer priority"]
        policyOne["1 MAX served orders; 2 MAX previous-deferred served; 3 MAX waiting-days served"]
        policyTwo["4 MAX low-flexibility served; 5 MAX Fresh chilled served; 6 MAX Fresh served"]
        policyThree["7A MIN avoidable reefer-van; 7B MIN avoidable reefer; 7C MIN avoidable van"]
    end

