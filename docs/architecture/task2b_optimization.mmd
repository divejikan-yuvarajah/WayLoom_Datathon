    officialOutput["Official output: scenario, order_ref, outlet_id, decision, vehicle_id, trip_id"]
    writtenPolicy["Separate Task 2B written prioritization policy"]
    excludedSignals["Not hard constraints: delivery windows, fuel, return journey, Task 1 predictions, Task 2A forecasts"]

