{
  "$defs": {
    "ForecastUncertainty": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "unofficial",
          "default": "unofficial",
          "title": "Status",
          "type": "string"
        },
        "target_coverage": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Target Coverage",
          "type": "number"
        },
        "total_lower_m3": {
          "minimum": 0,
          "title": "Total Lower M3",
          "type": "number"
        },
        "total_upper_m3": {
          "minimum": 0,
          "title": "Total Upper M3",
          "type": "number"
        }
      },
      "required": [
        "target_coverage",
        "total_lower_m3",
        "total_upper_m3"
      ],
      "title": "ForecastUncertainty",
      "type": "object"
    }
  },
  "$id": "https://wayloom.local/integration/1.0/demand_forecast.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "brand": {
            "enum": [
              "Style",
              "Tech"
            ]
          }
        },
        "required": [
          "brand"
        ]
      },
      "then": {
        "properties": {
          "pred_chilled_volume_m3": {
            "const": 0
          }
        }
      }
    }
  ],
  "properties": {
    "brand": {
      "enum": [
        "Fresh",
        "Style",
        "Tech"
      ],
      "title": "Brand",
      "type": "string"
    },
    "depot": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Depot",
      "type": "string"
    },
    "forecast_horizon": {
      "maximum": 10,
      "minimum": 1,
      "title": "Forecast Horizon",
      "type": "integer"
    },
    "forecast_ref": {
      "pattern": "^DEMO_FORECAST_[0-9]{3}$",
      "title": "Forecast Ref",
      "type": "string"
    },
    "iso_week": {
      "maximum": 53,
      "minimum": 1,
      "title": "Iso Week",
      "type": "integer"
    },
    "iso_year": {
      "maximum": 2100,
      "minimum": 2020,
      "title": "Iso Year",
      "type": "integer"
    },
    "pred_chilled_volume_m3": {
      "minimum": 0,
      "title": "Pred Chilled Volume M3",
      "type": "number"
    },
    "pred_total_volume_m3": {
      "minimum": 0,
      "title": "Pred Total Volume M3",
      "type": "number"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_mode": {
      "enum": [
        "synthetic_demo",
        "private_local"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "uncertainty": {
      "anyOf": [
        {
          "$ref": "#/$defs/ForecastUncertainty"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "source_mode",
    "forecast_ref",
    "depot",
    "brand",
    "iso_year",
    "iso_week",
    "forecast_horizon",
    "pred_total_volume_m3",
    "pred_chilled_volume_m3"
  ],
  "title": "DemandForecastResponse",
  "type": "object",
  "x-wayloom-semantic-rules": [
    "pred_chilled_volume_m3 <= pred_total_volume_m3"
  ]
}
